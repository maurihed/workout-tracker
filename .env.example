DATABASE_URL="postgresql://gym:gym@localhost:5432/gym?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
SENTRY_DSN=""
# Optional: enables client-side Sentry (the server SDK uses SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: disposable database used only by `prisma migrate diff` drift checks.
SHADOW_DATABASE_URL=""
# Guards the internal jobs endpoint (POST /api/jobs/repair-stats) via the x-job-secret header.
JOBS_SECRET=""
# DeepSeek API used by the AI routine generation worker (OpenAI-compatible).
# AI_API_KEY is required when these are set; leave AI_BASE_URL/AI_MODEL empty
# to use the deterministic template fallback.
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY=""
AI_MODEL="deepseek-flash"
AI_TIMEOUT_MS=""
# Optional: overrides the exercise dataset used by `pnpm db:seed`
# (defaults to the upstream `main` URL). Pin to a commit for
# reproducible production seeding; see docs/deploy.md.
FREE_EXERCISE_DB_URL=""
